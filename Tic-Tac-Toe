import math

def display_board(board):
    b = [cell if cell != ' ' else '_' for cell in board]
    print(f" {b[0]} | {b[1]} | {b[2]} ")
    print(f" {b[3]} | {b[4]} | {b[5]} ")
    print(f" {b[6]} | {b[7]} | {b[8]} ")

def check_win(board, player):
    win_conditions = [
        [0, 1, 2], [3, 4, 5], [6, 7, 8],  # Rows
        [0, 3, 6], [1, 4, 7], [2, 5, 8],  # Columns
        [0, 4, 8], [2, 4, 6]               # Diagonals
    ]
    for condition in win_conditions:
        if board[condition[0]] == board[condition[1]] == board[condition[2]] == player:
            return True
    return False

def is_board_full(board):
    return ' ' not in board

def minimax(board, depth, is_maximizing):
    if check_win(board, 'O'):
        return 10 - depth
    if check_win(board, 'X'):
        return depth - 10
    if is_board_full(board):
        return 0

    if is_maximizing:
        highest_score = -math.inf
        for i in range(9):
            if board[i] == ' ':
                board[i] = 'O'
                score = minimax(board, depth + 1, False)
                board[i] = ' '
                highest_score = max(highest_score, score)
        return highest_score
    else:
        lowest_score = math.inf
        for i in range(9):
            if board[i] == ' ':
                board[i] = 'X'
                score = minimax(board, depth + 1, True)
                board[i] = ' '
                lowest_score = min(lowest_score, score)
        return lowest_score

def find_best_move(board):
    best_score = -math.inf
    best_move = -1
    for i in range(9):
        if board[i] == ' ':
            board[i] = 'O'
            score = minimax(board, 0, False)
            board[i] = ' '
            if score > best_score:
                best_score = score
                best_move = i
    return best_move

def tic_tac_toe():
    board = [' '] * 9
    
    print("TIC-TAC-TOE")
    print("You are X")
    print("Computer is O\n")
    display_board(board)
    print()

    while True:
        valid_move = False
        while not valid_move:
            try:
                move_input = input("Enter position (1-9) : ").strip()
                position = int(move_input) - 1
                
                if position < 0 or position > 8:
                    print("Invalid move. Try again.\n")
                elif board[position] != ' ':
                    print("Invalid move. Try again.\n")
                else:
                    board[position] = 'X'
                    valid_move = True
            except ValueError:
                print("Invalid move. Try again.\n")

        display_board(board)
        print()

        if check_win(board, 'X'):
            print("You win!")
            break
        
        if is_board_full(board):
            print("Draw!")
            break

        computer_position = find_best_move(board)
        board[computer_position] = 'O'
        
        print(f"Computer chose position: {computer_position + 1}")
        display_board(board)
        print()

        if check_win(board, 'O'):
            print("Computer wins!")
            break
        
        if is_board_full(board):
            print("Draw!")
            break

if __name__ == "__main__":
    tic_tac_toe()
